# Copy this file to `.env` at the repo root and fill it in.
#   cp .env.example .env
#
# The four apps read from this one file in local development. On Vercel, each
# project gets its own environment variables — see docs/deployment.md.
#
# APPEND-ONLY: add your team's variables under a new `# --- team NN ---` header
# at the bottom. Do not reorder or reformat other teams' lines.

# --- team 01: platform ---------------------------------------------------
NODE_ENV=development

# Supabase configuration (PostgreSQL + Auth).
# For local development with Docker: run `npx supabase start` to get these values.
# For cloud development: copy from your Supabase project settings.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_service_role_key
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Where each frontend finds its API. The student app talks to api-student, the
# admin app talks to api-admin — never the other way round.
NEXT_PUBLIC_API_URL=http://localhost:4000

# The API's own public URL. Used to build local file-download links.
PUBLIC_API_URL=http://localhost:4000

# Comma-separated list of origins the APIs accept browser requests from.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# --- file storage (teams 04, 05, 09) -------------------------------------
# local    → writes to .local-uploads/ and serves files from the API.
#            No account needed. Leave this alone for local development.
# supabase → signed direct-to-Supabase Storage uploads. Deployed environments only.
STORAGE_DRIVER=local
# SUPABASE_STORAGE_BUCKET=uploads   (defaults to "uploads")
# LOCAL_STORAGE_DIR=                (defaults to .local-uploads/ at the repo root)

# --- email (teams 03, 08) ------------------------------------------------
# console → prints the email (and the reset link) to your terminal. Default.
# resend  → actually sends. Deployed environments only.
EMAIL_DRIVER=console
RESEND_API_KEY=
EMAIL_FROM=

# --- ai assistant (team 13) ----------------------------------------------
# stub      → deterministic canned replies and tool calls. No key, no cost.
#             Better than a real key for developing the tool loop, because a
#             deterministic tool call is something a test can assert on.
# anthropic → real Claude calls. Set on api-student only, never a frontend.
AI_DRIVER=stub
ANTHROPIC_API_KEY=
# Optional overrides. Default model is claude-opus-5; claude-sonnet-5 and
# claude-haiku-4-5 are cheaper if cost becomes a concern.
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=
